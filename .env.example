PORT=18082
APP_ORIGIN=http://localhost:18082
# The start script creates fresh secrets; never copy another installation's .env.
POSTGRES_PASSWORD=
COMMUNITY_IDENTITY_SECRET=
ANIMATION_API_KEY=
# Filled with the installation user's UID/GID by scripts/start.sh.
# Keep these consistent with the owner of data/effects when moving servers.
EFFECTS_UID=1000
EFFECTS_GID=1000
# Bundled GitLab and OAuth initialize by default. Set COMPOSE_PROFILES= to
# omit the GitLab container, and adjust repository settings in the dashboard.
COMPOSE_PROFILES=gitlab
COMMUNITY_REPOSITORY_DEFAULT=managed
# Generated during first initialization. Used only when GitLab creates root.
COMMUNITY_GITLAB_ROOT_PASSWORD=
# Existing installations can explicitly link their administrator UUID to the
# signed managed GitLab root identity. Fresh installs record this UUID themselves.
COMMUNITY_GITLAB_ADMIN_ACCOUNT_ID=
# Browser-facing URL; keep its port consistent with GITLAB_HTTP_PORT.
COMMUNITY_GITLAB_URL=http://localhost:18083
COMMUNITY_GITLAB_INTERNAL_URL=http://gitlab:80
GITLAB_HTTP_PORT=18083
GITLAB_SSH_PORT=12223
GITLAB_IMAGE=gitlab/gitlab-ce:19.4.7-ce.0
